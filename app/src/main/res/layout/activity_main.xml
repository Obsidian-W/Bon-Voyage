<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <include layout="@layout/view_screen_artwork" />
    <LinearLayout android:id="@+id/safeContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/homeToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/field_height" style="@style/PlannerPhotoToolbar" app:title="@string/app_display_name" app:menu="@menu/home_actions" />
        <com.google.android.material.tabs.TabLayout android:id="@+id/tab_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/tab_height" android:background="@color/planner_top_bar" app:tabMode="fixed" app:tabGravity="fill" app:tabTextColor="@color/planner_on_photo_muted" app:tabSelectedTextColor="@color/planner_on_photo" app:tabIndicatorColor="@color/planner_on_photo" app:tabRippleColor="@color/planner_photo_ripple">
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/current" />
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/previous" />
        </com.google.android.material.tabs.TabLayout>
        <LinearLayout android:id="@+id/tripControls" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:background="@color/planner_top_bar"
            android:paddingEnd="@dimen/space_8" android:visibility="gone">
            <androidx.appcompat.widget.SearchView android:id="@+id/searchView" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/field_height"
                android:theme="@style/ThemeOverlay.BonVoyage.PhotoSearch" app:queryHint="@string/filter_trips" app:queryBackground="@android:color/transparent" app:iconifiedByDefault="false" />
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/tripSort"
                android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true"
                app:selectionRequired="true" app:checkedButton="@id/sortByDate">
                <com.google.android.material.button.MaterialButton android:id="@+id/sortByDate"
                    style="@style/PlannerSortButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/sort_date_short" app:icon="@drawable/ic_sort_date" />
                <com.google.android.material.button.MaterialButton android:id="@+id/sortByName"
                    style="@style/PlannerSortButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/sort_az" android:contentDescription="@string/sort_name" app:icon="@drawable/ic_sort_name" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/countryRecycler" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingHorizontal="@dimen/space_8" android:paddingBottom="@dimen/space_8" android:clipChildren="false" />
            <paris.obsidian.bonvoyage.PhotoEmptyTextView android:id="@+id/emptyTrips" style="@style/PlannerPhotoEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="@dimen/space_32" android:text="@string/no_trips" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
