                <androidx.appcompat.widget.AppCompatTextView android:id="@+id/countryName" style="@style/PlannerTileText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="@dimen/tile_text_min" app:autoSizeMaxTextSize="@dimen/size_normal" app:autoSizeStepGranularity="@dimen/tile_text_step" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView android:id="@+id/tileDates" style="@style/PlannerTileText" android:layout_width="match_parent" android:layout_height="@dimen/tile_date_height" android:gravity="center" android:maxLines="1" android:ellipsize="end" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="@dimen/tile_text_min" app:autoSizeMaxTextSize="@dimen/size_caption" app:autoSizeStepGranularity="@dimen/tile_text_step" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
