<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="@dimen/space_16">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/summaryName" style="@style/PlannerText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textStyle="bold" />
        <ImageButton android:id="@+id/editSummary" style="@style/PlannerIcon" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:layout_marginStart="@dimen/space_8" android:src="@drawable/ic_edit" />
    </LinearLayout>
    <TextView android:id="@+id/summaryDetails" style="@style/PlannerText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_8" />
    <TextView android:id="@+id/summarySleeper" style="@style/PlannerCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_8" android:text="@string/sleeper_label" android:drawableStart="@drawable/ic_hotel" android:drawablePadding="@dimen/space_8" />
</LinearLayout>
